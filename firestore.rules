rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo pueden leer y escribir las cuentas indicadas por su UID (Authentication → Users → columna "UID de usuario").
    // Reemplaza los dos textos entre comillas por los UID reales.
    function permitido() {
      return request.auth != null
        && request.auth.uid in ['PEGA_AQUI_EL_UID_DE_YAMILETH', 'PEGA_AQUI_TU_UID'];
    }

    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
