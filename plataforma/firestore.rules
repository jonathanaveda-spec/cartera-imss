rules_version = '2';
// Reglas de la plataforma multiusuario.
//  - Cada asesor solo puede leer y escribir su propia cartera (usuarios/{su uid}/...), y solo con el correo verificado.
//  - El plan (planes/{uid}) y la configuración global (sistema/config) solo los cambia el administrador.
//  - El administrador puede leer para soporte; cada vez que abre la cartera de alguien queda en admin_log.
// Administrador: UID de la cuenta de Jonathan (Authentication → Users). Para agregar otro, suma su UID a la lista.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function verificado() { return logueado() && request.auth.token.email_verified == true; }
    function esAdmin() { return logueado() && request.auth.uid in ['45YfsHUZpoSf5mmYJOWBcPLyreA2']; }
    function esDueno(uid) { return logueado() && request.auth.uid == uid; }
    function soloCampos(permitidos) { return request.resource.data.keys().hasOnly(permitidos); }
    function texto(v, max) { return v is string && v.size() <= max; }

    // Datos del perfil con tipos y largos razonables.
    function perfilValido() {
      let d = request.resource.data;
      return soloCampos(['nombre', 'correo', 'pais', 'telefono', 'creado', 'aceptoTerminos'])
        && texto(d.nombre, 100) && texto(d.telefono, 30)
        && d.pais in ['MX', 'CO', 'VE', 'OTRO', ''];
    }

    // Datos técnicos que acompañan un ticket: solo campos conocidos y de tamaño acotado.
    function contextoValido(c) {
      return c is map
        && c.keys().hasOnly(['version', 'navegador', 'pantalla', 'enLinea', 'clientes', 'plan', 'ultimoError', 'errorSincro'])
        && texto(c.get('navegador', ''), 400) && texto(c.get('ultimoError', ''), 400) && texto(c.get('errorSincro', ''), 400)
        && texto(c.get('version', ''), 40) && texto(c.get('pantalla', ''), 20) && texto(c.get('plan', ''), 20);
    }

    // Configuración global: beta abierta, límite del plan gratis, datos de pago.
    match /sistema/{doc} {
      allow read: if logueado();
      allow write: if esAdmin();
    }

    // Perfil del asesor. Se puede crear antes de verificar el correo (se crea al registrarse).
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow create: if esDueno(uid) && perfilValido()
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.creado == request.time;
      allow update: if esDueno(uid) && perfilValido()
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.creado == resource.data.creado;
      allow delete: if esDueno(uid) || esAdmin();   // el administrador puede borrar asesores (cuentas de prueba, etc.)

      // Cartera: clientes, papelera, historial y configuración propia.
      // Al escribir, topes amplios de tamaño (muy por encima del uso normal) para que nadie llene la cuota gratis del proyecto.
      match /{coleccion}/{docId} {
        allow read, delete: if esDueno(uid) && verificado()
          && coleccion in ['clientes', 'papelera', 'historial', 'config'];
        allow create, update: if esDueno(uid) && verificado() && docId.size() <= 100
          && carteraValida(coleccion, docId, request.resource.data);
        allow read, delete: if esAdmin();
      }
    }

    // Un dato viejo guardado como número no debe trabar la sincronización: solo se limita el largo de los textos.
    function textoONulo(m, campo, max) { let v = m.get(campo, null); return v == null || v is number || v is bool || texto(v, max); }
    function listaHasta(m, campo, max) { return m.get(campo, []) is list && m.get(campo, []).size() <= max; }
    function clienteValido(c) {
      return c is map && c.keys().size() <= 200
        && textoONulo(c, 'nombre', 1000) && textoONulo(c, 'notas', 50000)
        && textoONulo(c, 'curp', 100) && textoONulo(c, 'nss', 100) && textoONulo(c, 'celular', 100)
        && textoONulo(c, 'opcion', 1000) && textoONulo(c, 'proveedor', 1000)
        && listaHasta(c, 'pagos', 5000) && listaHasta(c, 'etiquetas', 100)
        && c.get('extra', {}) is map && c.get('extra', {}).size() <= 200;
    }
    // Aviso diario (lo lee tools/enviar-avisos.mjs): solo sus campos y pocos teléfonos.
    function avisosValido(d) {
      return d.keys().hasOnly(['activo', 'hora', 'zona', 'tokens', 'ultimoEnvio'])
        && d.get('activo', false) is bool
        && (d.get('hora', 8) is int && d.get('hora', 8) >= 0 && d.get('hora', 8) <= 23)
        && textoONulo(d, 'zona', 60)
        && d.get('tokens', {}) is map && d.get('tokens', {}).size() <= 20;
    }
    function carteraValida(coleccion, docId, d) {
      return (coleccion == 'clientes' && clienteValido(d))
        || (coleccion == 'papelera' && d.keys().size() <= 10 && clienteValido(d.get('cliente', {})))
        || (coleccion == 'historial' && d.keys().size() <= 20 && textoONulo(d, 'detalle', 5000) && listaHasta(d, 'cambios', 500))
        || (coleccion == 'config' && ((docId == 'main' && d.keys().size() <= 100 && listaHasta(d, 'importaciones', 1000)
                                                        && listaHasta(d, 'camposPersonalizados', 200))
                                      || (docId == 'avisos' && avisosValido(d))));
    }

    // Plan de cada asesor: solo lo activa o cambia el administrador.
    match /planes/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow write: if esAdmin();
    }

    // Soporte: cada conversación es un ticket con sus mensajes en tickets/{id}/mensajes.
    function conversacionNueva() {
      let d = request.resource.data;
      return soloCampos(['uid', 'correo', 'nombre', 'tipo', 'asunto', 'contexto', 'estado', 'creado', 'actualizado',
                         'ultimoDe', 'ultimoMensaje', 'noLeidoAdmin', 'noLeidoAsesor'])
        && d.uid == request.auth.uid && d.correo == request.auth.token.email
        && texto(d.nombre, 100) && texto(d.asunto, 200) && texto(d.ultimoMensaje, 200)
        && d.tipo in ['problema', 'pregunta', 'sugerencia', 'pago']
        && d.estado == 'abierto' && d.ultimoDe == 'asesor' && d.noLeidoAdmin == true && d.noLeidoAsesor == false
        && d.creado == request.time && d.actualizado == request.time
        && contextoValido(d.contexto);
    }
    // El asesor solo puede: marcar como leída la respuesta, o escribir de nuevo (lo que reabre la conversación).
    function cambioDelAsesor() {
      let d = request.resource.data;
      let cambios = d.diff(resource.data).affectedKeys();
      return resource.data.uid == request.auth.uid && verificado()
        && cambios.hasOnly(['estado', 'actualizado', 'ultimoDe', 'ultimoMensaje', 'noLeidoAdmin', 'noLeidoAsesor'])
        && d.noLeidoAsesor == false
        && (d.estado == resource.data.estado || d.estado == 'abierto')
        && (!cambios.hasAny(['ultimoDe']) || d.ultimoDe == 'asesor')
        && (!cambios.hasAny(['noLeidoAdmin']) || d.noLeidoAdmin == true)
        && (!cambios.hasAny(['actualizado']) || d.actualizado == request.time)
        && (!cambios.hasAny(['ultimoMensaje']) || texto(d.ultimoMensaje, 200));
    }
    function duenoDelTicket(id) {
      return get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid;
    }

    match /tickets/{id} {
      allow create: if (verificado() && conversacionNueva()) || esAdmin();   // soporte también puede iniciar una conversación
      allow read: if logueado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow update: if esAdmin() || cambioDelAsesor();
      allow delete: if esAdmin();

      match /mensajes/{mid} {
        allow read: if esAdmin() || (logueado() && duenoDelTicket(id));
        allow create: if logueado()
          && request.resource.data.keys().hasOnly(['de', 'texto', 'autor', 'creado'])
          && texto(request.resource.data.texto, 2000) && request.resource.data.texto.size() > 0
          && request.resource.data.autor == request.auth.token.email
          && request.resource.data.creado == request.time
          && ((esAdmin() && request.resource.data.de == 'soporte')
              || (verificado() && request.resource.data.de == 'asesor' && duenoDelTicket(id)));
        allow delete: if esAdmin();
      }
    }

    // Pagos del Plan Pro: los registra el administrador; cada asesor solo ve los suyos.
    match /pagos_plan/{id} {
      allow read: if logueado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    // Registro de acciones del administrador (no se puede modificar ni borrar).
    match /admin_log/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.admin == request.auth.token.email
        && request.resource.data.ts == request.time;
    }
  }
}
