tools/crear-respaldo-inicial.mjs
tests/excel.test.mjs
# Local (menos las skills de diseño: así Claude las tiene en cualquier PC o en la nube)
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/equipo.md
node_modules/

# Capturas sin marco (se rehacen con tools/capturas-play.mjs)
tienda/capturas/crudas/
# Proyecto de videos (Remotion): dependencias y videos exportados no se suben
videos/node_modules/
videos/out/
# Voz en off generada con Azure (se rehace con: cd videos && node voz.mjs voz/<video>.json)
videos/public/voz/

# Carpeta de trabajo con grabaciones y material crudo (puede tener datos personales): no se sube.
# Solo queda el logo que ya estaba en el repo. (Revisión de Fernanda, 07/10/2026)
imagenes/*
!imagenes/c65ea44d-f569-4876-89ee-174ced93b80e.png

# Llaves y secretos (sobre todo la llave de firma de Google Play: si se sube, se pierde el control de la app)
*.jks
*.keystore
*.pem
*.p12
*.key
.env*
google-services.json
GoogleService-Info.plist

# Única excepción a *.xlsx: clientes 100 % INVENTADOS para la cuenta de prueba del revisor de Google Play
# (se genera con tools/clientes-demo-revisor.mjs; nunca poner aquí datos reales)
!tienda/cuenta-prueba/clientes-demo.xlsx

# Paquetes de Android y datos de la llave de firma (PWABuilder los entrega en un .zip: guardarlos FUERA del repositorio)
signing-key-info*
*.aab
*.apk
